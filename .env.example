# ============================================================
# Odoo MCP Connector — Environment Variables
# Copy this to .env for local use. On Render, set these in
# the Environment tab of your Web Service.
# ============================================================

# ---------- AUTH ----------
# Required. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ODOO_AGENT_API_TOKEN=change-me-to-a-long-random-secret

# ---------- FILE SYSTEM ----------
ODOO_AGENT_ALLOWED_ROOTS=/workspace/repos,/tmp,/home/odoo/src
ODOO_AGENT_STATE_DIR=/tmp/odoo_agent_state
ODOO_AGENT_SCREENSHOT_DIR=/tmp/odoo_agent_screenshots
# Optional, OPERATOR-PROVIDED. External Chrome/Chromium remote-debugging
# endpoint for UI console diagnostics (browser.screenshot / browser.pos_flow).
# The connector never downloads or launches a browser itself, and an MCP agent
# cannot provision one. Leave empty to disable browser verification; those
# tools then return a clear "not configured" result.
# Example: http://chrome-host:9222
ODOO_AGENT_CDP_URL=

# ---------- APPROVAL GATING ----------
# High-impact mutations require approval by default; read-only calls remain free.
ODOO_AGENT_REQUIRE_APPROVAL=true
ODOO_AGENT_APPROVAL_REQUIRED_ACTIONS=repo.prepare,repo.write,repo.delete,repo.apply_patch,repo.apply_patch_atomic,repo.clean_pyc,git.commit,git.push,odoo.module_install,odoo.module_update,odoosh.module_install_ssh,odoosh.module_deploy_ssh,workflow.safe_deploy_module,odoo.record_action.*
ODOO_AGENT_PROTECTED_BRANCHES=

# ---------- GITHUB / GIT ----------
# SSH private key base64-encoded. On Render, paste base64 output of:
#   base64 -w 0 ~/.ssh/github_mcp_key
GITHUB_SSH_PRIVATE_KEY_B64=

# Your repo SSH URL and target branch
TARGET_GIT_REPO=git@github.com:YourUser/your-odoo-repo.git
TARGET_GIT_BRANCH=your-staging-branch
TARGET_PROJECT_PATH=/workspace/repos/your-repo-folder
WORKSPACE_ROOT=/workspace/repos
GIT_AUTHOR_NAME=Odoo MCP Agent
GIT_AUTHOR_EMAIL=odoo-mcp@example.local

# ---------- ODOO.SH SSH ----------
# SSH private key base64-encoded for Odoo.sh build SSH access
ODOOSH_SSH_PRIVATE_KEY_B64=

ODOOSH_SSH_HOST=your-build-ssh.odoo.com
ODOOSH_SSH_USER=odoo
ODOOSH_SSH_PORT=22
ODOOSH_DB_NAME=your-build-database-name
ODOOSH_ODOO_PATH=/home/odoo/src/odoo
ODOOSH_USER_ADDONS_PATH=/home/odoo/src/user
ODOOSH_WAIT_TIMEOUT_SECONDS=600
ODOOSH_WAIT_INTERVAL_SECONDS=10

# ---------- ODOO Odoo shell ----------
ODOO_BASE_URL=https://your-instance.odoo.com
ODOO_DB_NAME=your-database-name
ODOO_LOGIN=admin@example.com
ODOO_PASSWORD=change-me
# Odoo 19+ External JSON-2 API key (alternative to username/password for supported read calls)
ODOO_API_KEY=

# ---------- LIVE FUNCTIONAL OPERATIONS ----------
# Keep disabled until authenticated-user permissions and recipes are verified
# against a test database. No SSH/superuser mutation fallback is used.
ODOO_AGENT_FUNCTIONAL_OPERATIONS_ENABLED=false
ODOO_AGENT_FUNCTIONAL_MAX_BATCH_RECORDS=20

# ---------- OAUTH (MCP Auth) ----------
# Set to your Render public URL
ODOO_AGENT_PUBLIC_BASE_URL=https://your-service-name.onrender.com
ODOO_AGENT_OAUTH_ISSUER=
ODOO_AGENT_OAUTH_DEFAULT_SCOPE=odoo.agent
# Set false for production — consent page requires API token
ODOO_AGENT_OAUTH_AUTO_APPROVE=false
ODOO_AGENT_OAUTH_STATIC_CLIENT_ID=odoo-agent-mcp
ODOO_AGENT_OAUTH_STATIC_CLIENT_SECRET=
# IMPORTANT: Set this stable secret — prevents MCP session loss on redeploys
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ODOO_AGENT_OAUTH_TOKEN_SECRET=change-me-to-stable-secret
# Optional dedicated signer for ChatGPT-carried workflow resume tokens. Keep it
# stable across Render restarts/redeploys; falls back to OAuth secret/API token.
ODOO_AGENT_CONTINUATION_TOKEN_SECRET=change-me-to-stable-secret
ODOO_AGENT_CONTINUATION_TOKEN_TTL_SECONDS=2592000
ODOO_AGENT_OAUTH_ALLOWED_REDIRECT_URIS=
# Native/CLI clients (Claude Code, other local agents) use a loopback
# http redirect. Keep loopback enabled unless your policy forbids it.
ODOO_AGENT_OAUTH_ALLOW_LOOPBACK_REDIRECTS=true
# Headless/dev convenience: auto-approve loopback OAuth redirects so a local
# CLI can finish authorization without a browser consent form. Set false for
# shared/public deployments where a human must paste the admin token.
ODOO_AGENT_OAUTH_AUTO_APPROVE_LOOPBACK=true
ODOO_AGENT_OAUTH_AUTH_CODE_TTL_SECONDS=600
ODOO_AGENT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
ODOO_AGENT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------- FAST-SAFE WRITES ----------
# repo.write_many_smart uses fast-safe lock+backup+rollback below these limits,
# then falls back to repo.write_many_atomic for larger/riskier changes.
ODOO_AGENT_FAST_WRITE_MAX_FILES=50
ODOO_AGENT_FAST_WRITE_MAX_BYTES_EACH=500000
ODOO_AGENT_FAST_WRITE_MAX_TOTAL_BYTES=5000000

# One pulled/inspected module snapshot is reused for inspect -> write -> repair.
# ZIP bundles are internal checkpoints; only final source files are committed.
ODOO_AGENT_CODING_SESSION_TTL_SECONDS=3600
ODOO_AGENT_CODING_SESSION_MAX_COUNT=20
ODOO_AGENT_CODING_SESSION_BUNDLE_MAX_FILES=2000
ODOO_AGENT_CODING_SESSION_BUNDLE_MAX_BYTES=50000000
ODOO_AGENT_CODING_SESSION_MAX_TOTAL_BYTES=250000000
ODOO_AGENT_CODING_WORKSPACE_MAX_MODULES=5
ODOO_AGENT_CODING_WORKSPACE_TTL_SECONDS=14400
ODOO_AGENT_CODING_WORKSPACE_MAX_COUNT=20
ODOO_AGENT_CODING_WORKSPACE_MAX_TOTAL_BYTES=500000000
ODOO_AGENT_CODING_WORKFLOW_MAX_WORKERS=2
ODOO_AGENT_CODING_WORKFLOW_MAX_QUEUE=2
ODOO_AGENT_JOB_MAX_COUNT=500
ODOO_AGENT_ARTIFACT_TTL_SECONDS=604800
ODOO_AGENT_ARTIFACT_MAX_COUNT=500
ODOO_AGENT_ARTIFACT_MAX_TOTAL_BYTES=250000000

# ---------- FAST/CORRECT AGENT CACHES ----------
# Caches preflight pattern discovery and repo module/assets/template index.
ODOO_AGENT_PATTERN_CACHE_ENABLED=true
ODOO_AGENT_PATTERN_CACHE_SECONDS=3600
ODOO_AGENT_PATTERN_CACHE_DIR=/workspace/odoo_agent_cache
ODOO_AGENT_REPO_INDEX_ENABLED=true
ODOO_AGENT_REPO_INDEX_CACHE_SECONDS=3600
ODOO_AGENT_VERIFY_IMPACT_AWARE_DEFAULT=true

# ---------- PHASE-AWARE WORKFLOW WATCHDOG ----------
# safe_redirect time-bounds only explicitly allowlisted read-only MCP calls.
# Coding, writes, Git, deploys, upgrades, migrations and unknown jobs are protected.
ODOO_AGENT_WATCHDOG_ENABLED=true
ODOO_AGENT_WATCHDOG_MODE=safe_redirect
ODOO_AGENT_WATCHDOG_OBSERVATION_BUDGET_SECONDS=120
# Used only for legacy jobs that do not expose an authoritative phase_started_at.
ODOO_AGENT_WATCHDOG_STALL_CONFIRMATIONS=2
ODOO_AGENT_WATCHDOG_WAIT_CAP_SECONDS=30

# ---------- QWEN SHORT URL TOKEN ----------
# Prefer POST /qwen/token with normal bearer/OAuth auth, then put the returned
# /qwen/mcp/<short_token> URL into Qwen app with Auth=None.
ODOO_AGENT_QWEN_SHORT_TOKEN_TTL_SECONDS=3600

# ---------- ODOO HTTPS JSON-RPC FALLBACK ----------
# Keep true in production. For known Odoo.sh/dev certificate-hostname mismatch
# during read-only JSON-RPC fallback, set per-client odoo_verify_ssl=false instead.
ODOO_HTTPS_VERIFY_SSL=true

# ---------- MULTI-CLIENT MODE ----------
# Preferred for more than one Odoo/Odoo.sh project. Each selected client carries
# its own GitHub repo/branch/path, Odoo shell credentials, and Odoo.sh SSH values.
# When these per-client Odoo.sh keys exist, MCP uses them for safe deploy,
# Odoo.sh polling, deployed-source reads, and module upgrade verification.
ODOO_CLIENTS='[
  {
    "name": "Client A",
    "repo": "https://github.com/YourUser/test_18.git",
    "branch": "feature_branch",
    "path": "/workspace/repos/client_a",
    "environment": "test",
    "token": "github_token_for_this_repo",
    "odoo_url": "https://test-18.dev.odoo.com",
    "odoo_db": "test-18-db",
    "odoo_login": "admin@example.com",
    "odoo_password": "odoo_password",
    "odoo_api_key": "",
    "odoo_verify_ssl": true,
    "odoosh_db_name": "test-18-db",
    "odoosh_ssh_host": "test-18.dev.odoo.com",
    "odoosh_ssh_port": 22,
    "odoosh_ssh_user": "odoosh_user_id",
    "odoosh_ssh_private_key_b64": "base64_private_key_for_this_odoosh_project",
    "odoosh_odoo_path": "/home/odoo/src/odoo",
    "odoosh_user_addons_path": "/home/odoo/src/user"
  }
]'

# Allow verified GitHub-only push when Odoo.sh SSH/public-key validation is unavailable.
ODOO_AGENT_GITHUB_PUSH_FALLBACK_ENABLED=true
