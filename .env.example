# Direct ChatGPT connector auth.
ODOO_AGENT_API_TOKEN=change-me-to-a-long-random-secret

# Strict comma-separated repo roots. All file/Git operations are blocked outside these roots.
ODOO_AGENT_ALLOWED_ROOTS=/workspace/repos,/tmp

# Local file state for approvals, jobs, and audit events.
ODOO_AGENT_STATE_DIR=/tmp/odoo_agent_state
ODOO_AGENT_SCREENSHOT_DIR=/tmp/odoo_agent_screenshots

# Production safety. Set true when deployed publicly or connected to ChatGPT.
ODOO_AGENT_REQUIRE_APPROVAL=true
ODOO_AGENT_APPROVAL_REQUIRED_ACTIONS=repo.write,repo.delete,repo.apply_patch,repo.clean_pyc,git.commit,git.push,odoo.module_install,odoo.module_update,odoosh.module_update
ODOO_AGENT_PROTECTED_BRANCHES=main,master,production,prod,live

# Optional Odoo XML-RPC defaults.
ODOO_BASE_URL=https://your-odoo-instance.odoo.com
ODOO_DB_NAME=your_database_name
ODOO_LOGIN=admin@example.com
ODOO_PASSWORD=change-me

# Optional Odoo.sh SSH connector. Use development/staging build SSH details.
ODOOSH_SSH_HOST=your-build-ssh-host.odoo.com
ODOOSH_SSH_USER=odoo
ODOOSH_SSH_PORT=22
ODOOSH_SSH_KEY_PATH=/home/agent/.ssh/odoosh_key
ODOOSH_DB_NAME=your_build_database_name

# OAuth 2.1 / PKCE for ChatGPT custom MCP Apps.
# Set this to your tunnel/VPS base URL when possible, for example:
# ODOO_AGENT_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
ODOO_AGENT_PUBLIC_BASE_URL=
ODOO_AGENT_OAUTH_ISSUER=
ODOO_AGENT_OAUTH_DEFAULT_SCOPE=odoo.agent
# For local testing only. Keep false for public use so the consent page asks for ODOO_AGENT_API_TOKEN.
ODOO_AGENT_OAUTH_AUTO_APPROVE=false
# Static user-defined OAuth client fallback. DCR is also supported at /oauth/register.
ODOO_AGENT_OAUTH_STATIC_CLIENT_ID=odoo-agent-chatgpt
ODOO_AGENT_OAUTH_STATIC_CLIENT_SECRET=
# Optional comma-separated redirect URI allowlist. Leave blank for DCR or ChatGPT/OpenAI redirect hosts.
ODOO_AGENT_OAUTH_ALLOWED_REDIRECT_URIS=
ODOO_AGENT_OAUTH_AUTH_CODE_TTL_SECONDS=600
ODOO_AGENT_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
ODOO_AGENT_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
